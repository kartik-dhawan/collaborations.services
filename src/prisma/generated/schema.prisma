// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String
  role      Role      @default(USER)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model ClientData {
  id              String           @id @default(uuid())
  name            String
  instagram       String?
  createdAt       DateTime         @default(now())
  clientContactId String
  contactPeople   ClientContact[]  @relation("clientToContact")
  collaborations  Collaborations[] @relation("clientToCollab")
  clientNotes     String?
}

model ClientContact {
  id           String     @id @default(uuid())
  name         String?
  email        String?
  phone        String?
  createdAt    DateTime   @default(now())
  clientId     String
  client       ClientData @relation("clientToContact", fields: [clientId], references: [id])
  contactNotes String?
  gender       CsGender   @default(PREFER_NOT_TO_SAY)
}

model Collaborations {
  id                String                      @id @default(uuid())
  name              String?
  type              CollabType
  collabStatus      CollaborationStatus
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime?                   @updatedAt
  dealDate          DateTime?
  paymentStatus     PaymentStatus               @default(PENDING)
  paymentAmount     Int?                        @default(0)
  paymentDate       DateTime?
  clientId          String
  client            ClientData                  @relation("clientToCollab", fields: [clientId], references: [id])
  deliverables      CollaborationDeliverables[]
  deliverableDate   DateTime?
  deliverableLink   String?
  deliverableStatus DeliverableStatus           @default(IN_REVIEW)
  deliverableNotes  String?
  collabNotes       String?
}

enum Role {
  USER
  ADMIN
}

enum CsGender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum CollabType {
  UNPAID_COLLABORATION
  PAID_COLLABORATION
  BARTER_COLLABORATION
  PAID_PROMOTION
  PAID_GIG
}

enum PaymentStatus {
  PENDING
  PAID
  UNPAID
}

enum CollaborationStatus {
  FINALISED
  DID_NOT_HAPPEN
  COMPLETED
}

enum CollaborationDeliverables {
  REEL
  REEL_WITHOUT_COLLAB
  CAROUSEL_POST
  CAROUSEL_POST_WITHOUT_COLLAB
  STORIES
  SONG_PROMOTION
  PHOTO_SHOOT
  VIDEO_EDIT
}

enum DeliverableStatus {
  COMPLETED
  CANCELLED
  IN_PROGRESS
  REJECTED
  APPROVED
  IN_REVIEW
}
